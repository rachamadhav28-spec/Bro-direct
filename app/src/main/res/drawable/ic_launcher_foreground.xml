<?xml version="1.0" encoding="utf-8"?>
<!-- BRO Nova mark. Put in res/drawable/ic_launcher_foreground.xml -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- orbit ring -->
    <path
        android:pathData="M54,54m-25,0a25,25 0,1 1,50 0a25,25 0,1 1,-50 0"
        android:strokeColor="#59A78BFA"
        android:strokeWidth="1" />

    <!-- four-point star -->
    <path android:pathData="M54,31.96 C55.16,45.88 62.12,52.84 76.04,54 C62.12,55.16 55.16,62.12 54,76.04 C52.84,62.12 45.88,55.16 31.96,54 C45.88,52.84 52.84,45.88 54,31.96 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36" android:startY="36"
                android:endX="72" android:endY="72"
                android:type="linear">
                <item android:color="#FFFFFFFF" android:offset="0" />
                <item android:color="#FFB9A4FF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- moon on the orbit -->
    <path
        android:pathData="M54,29m-2.4,0a2.4,2.4 0,1 1,4.8 0a2.4,2.4 0,1 1,-4.8 0"
        android:fillColor="#FFD8CCFF" />

    <!-- small twinkle -->
    <path
        android:pathData="M72,33 C72.4,35.4 73.2,36.2 75.6,36.6 C73.2,37 72.4,37.8 72,40.2 C71.6,37.8 70.8,37 68.4,36.6 C70.8,36.2 71.6,35.4 72,33 Z"
        android:fillColor="#FFE9E2FF" />
</vector>
